		(uuid "7def4b64-cd79-4d13-9049-223ea9ef9a3e")
	)
	(text "VDD is REG0,\nit defaults\nto +1V8 and\ncan be set\nto V_REG0."
		(exclude_from_sim no)
		(at 58.42 106.68 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "9341f99d-c270-4bf2-92fe-af0cfd41fa73")
	)
	(text "Set up resets for the device.\nCentralize the decoupling for VDDH"
		(exclude_from_sim no)
		(at 17.78 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a6d10b6a-7858-464d-8140-b664cc3ae88c")
	)
	(text "Consider if there enough space for UART debug. No there will not be"
		(exclude_from_sim no)
		(at 17.78 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b6f5a7a1-0838-4512-ae65-ae63eb063026")
	)
	(text "Verify that this is \nenough to program \nthis board"
		(exclude_from_sim no)
		(at 55.88 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb1ed79f-6da1-457e-91b4-2de6356e3d9f")
	)
	(text "Almost any pin can be used for i2c on the nrf52. Sight this source\nSo I'll use P0.00 and P0.01.\nThis might be problematic as these pins are used for the secondary clock."
		(exclude_from_sim no)
		(at 17.78 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bb9c8b4c-5b9d-49c9-9d1f-c6f86b991897")
	)
	(text "Regulator 0 \n& Regulator 1\nare both set\nto LDO mode"
