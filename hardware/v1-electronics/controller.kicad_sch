	(text "This circuit is designed to allow for both\na analog and digital method of interrupt\ndetection.\n\nIt uses a voltage ladder. \nAll values varified\n\nActive interrupts	Node voltage\n------------------------\nnone				3.30 V \ndriver #2 (22 k)	2.27 V\ndriver #1 (10 k)	1.65 V\n#1 + #2				1.34 V\nMP2721 (4.7 k)		1.06 V\nMP2721 + #2			0.92 V\nMP2721 + #1			0.80 V\nall three			0.72 V"
		(exclude_from_sim no)
		(at 81.28 154.94 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "2ca5c71e-3eb3-477d-800c-e231ed723fd9")
	)
	(text "The datasheet\nin unclear about \nbehavior of this \npin\n\nI't is possible \nwe may need to\nset this manually"
		(exclude_from_sim no)
		(at 58.42 127 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "4c4fb1fa-0af5-4af6-8a9b-fde296b7b29c")
	)
