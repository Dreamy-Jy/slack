# Manufacturability check: measure the bar and both caps, and hold every
# measurement to JLC's and PCBWay's published rules for every 3D-printing
# process and CNC milling, in every material group.
#
# Run it in FreeCAD 1.1.3 with scrollbar.FCStd open. It only reports. It
# switches cap_mount between pegs and inserts to check both, inside one undo
# step that it throws away at the end, so the model ends exactly as it was.
#
# For each part it measures:
#   size      the part's exact box
#   wall      the thinnest wall: from points spread over every face, a line
#             straight into the material; where it comes out is the wall there
#   holes     every round hole: diameter and depth
#   pins      every round pin (pegs, bar sections), plus the bar's hex shaft
#   spin      the gap around the bar where it turns in its cap (the shortest
#             distance from each bar to its cap, in the assembly)
#   click     whether that gap lets the bar wobble more than its switch's travel
#   fits      the bar's fits to bought parts: the switches (actuation_gap) and
#             the encoder's bore (1.73 +0.05/0)
#   detail    the shortest straight run in each cap's bottom outline
#   corners   sharp inside corners running up and down (CNC only)
# Then it prints one table per part: a row per check, a column per process
# and material group, each cell "JLC/PCBWay":
#   ok    meets the rule          warn  close to it, or a tolerance is bigger
#   FAIL  under the limit                than the gap it has to keep
#   -     the maker publishes no rule for this
#   .     the maker doesn't offer this process
# Under each table it says what value would pass, for every warn and FAIL.
# It ends with every FAIL, worst first.
# It also saves a picture of each part next to your FreeCAD file, in a
# "manufacturability" folder: three views (from below, the bottom, and a cut
# along the bar's axis with the bar drawn in) with every problem numbered on
# the part and explained in a list under the views. It needs matplotlib, which
# comes with FreeCAD; without it the check still runs, without pictures.
#
# Rules read 2026-10-12 from:
#   JLC3DP  https://jlc3dp.com/help/article/3D-Printing-Design-Guideline
#   JLCCNC  https://jlccnc.com/help/article/cnc-machining-design-guideline
#   PCBWay  https://www.pcbway.com/rapid-prototyping/3D-Printing/ (SLA, DLP,
#           PolyJet, SLS, SLM, FDM pages) and /rapid-prototyping/cnc-machining/
# Decided 2026-10-13: the gap where the bar turns is held to the makers'
# fitted-parts gap (not the moving-parts gap), and checked against the
# switch's travel, so the fix for rubbing doesn't add more wobble than the
# click can take. Decided 2026-10-12: PCBWay CNC uses
# ISO 2768-m (±0.1 for sizes up to 6 mm); PCBWay MJF rules are only on its
# quote page, so its MJF column is all "-".

import math
import os
import textwrap
import time

import FreeCAD as App
import Part

doc = App.ActiveDocument
say = App.Console.PrintMessage

PARTS = {   # name in the report: master body
    "bar": "Body005",
    "switched cap": "Body007",
    "plain cap": "Body010",
}
PAIRS = [   # (board, bar link, cap link, cap part): bar and cap as assembled
    ("B1", "Link007", "Link009", "switched cap"),
    ("B2", "Link008", "Link010", "plain cap"),
]
HEX_FIT = 0.05   # the encoder's bore: 1.73 +0.05/0 (Alps drawing, detail E)
# How far each board's switch travels before it clicks, from its datasheet.
# None = not filled in yet: the click check then shows "-". Fill these in.
SWITCH_TRAVEL = {
    "switched cap": None,   # B1: XKB TC-1109-C-E, under the bar's end in this cap
    "plain cap": None,      # B2: Alps SKQGAKE010, under the bar's middle
}
SAMPLES = (0.2, 0.5, 0.8)   # where on each face the wall probe starts (u and v)
RAY = 30.0   # longest wall a probe looks for, mm

# ================================================================ the rules
# wall: thinnest wall; a dict means "by the part's largest size, up to N mm"
# wall_rec: recommended wall (under it is a warn, under wall a FAIL)
# hole: smallest hole; deep: deepest hole as a multiple of its diameter
# pins: (smallest diameter, tallest pin at that diameter); 3.0 and up passes
# gap: moving-parts gap (kept for reference; the bar is held to fit)
# fit / fit_rec: gap between parts printed apart and fitted together
#   (under fit is a FAIL, under fit_rec a warn); detail: smallest detail; tol: ± tolerance
# small / big: smallest and largest part (sorted sizes); several = any one
# protrude: thinnest peg or snap; corner: CNC inside-corner rule

JLC_PINS = [(2.0, 4.0), (3.0, 6.0)]
RULES = {
    "SLA": {
        "JLC": dict(wall={5: 0.5, 10: 0.8, 50: 1.0, 100: 1.5, 200: 2.0}, hole=1.0, deep=3,
                    pins=[(1.0, 1.0)] + JLC_PINS, gap=0.5, fit=0.2, detail=0.8, tol=0.2,
                    small=[(5, 5, 5), (2, 2, 10)], big=(530, 780, 780), protrude=1.5),
        "PCBWay": dict(wall=0.8, tol=0.2, big=(700, 800, 2100)),
    },
    "DLP": {
        "JLC": None,
        "PCBWay": dict(wall=0.8, tol=0.1, big=(130, 230, 300)),
    },
    "Jetting": {   # JLC WJP, PCBWay PolyJet
        "JLC": dict(small=[(5, 5, 5), (2, 2, 10)], big=(230, 330, 380)),
        "PCBWay": dict(wall=1.0, tol=0.1, small=[(5, 5, 5)], big=(200, 390, 490)),
    },
    "MJF": {
        "JLC": dict(wall={5: 1.0, 10: 1.2, 50: 1.5, 100: 2.0, 200: 2.0}, hole=1.5, deep=3,
                    pins=JLC_PINS, gap=0.6, fit=0.2, fit_rec=0.4, detail=0.8, tol=0.3,
                    small=[(5, 5, 5), (2, 2, 10)], big=(276, 360, 370), protrude=1.5),
        "PCBWay": dict(),
    },
    "SLS": {
        "JLC": dict(wall={5: 1.0, 10: 1.2, 50: 1.5, 100: 2.0, 200: 2.0}, hole=1.5, deep=3,
                    pins=JLC_PINS, gap=0.6, fit=0.2, fit_rec=0.4, detail=0.8, tol=0.3,
                    small=[(5, 5, 5), (2, 2, 10)], big=(350, 350, 400), protrude=1.5),
        "PCBWay": dict(wall=1.0, tol=0.25, big=(390, 390, 400)),
    },
    "SLM": {
        "JLC": dict(wall={5: 1.5, 10: 1.5, 50: 1.5, 100: 2.0, 200: 2.5}, hole=1.5, deep=3,
                    pins=JLC_PINS, gap=1.0, fit=0.5, detail=1.0, tol=0.3,
                    small=[(5, 5, 5), (2, 2, 10)], big=(290, 390, 390), protrude=1.5),
        "PCBWay": dict(wall=1.0, tol=0.3, big=(300, 300, 300)),
    },
    "Binder jet": {
        "JLC": dict(wall={5: 1.5, 10: 1.5, 50: 1.5, 100: 2.0}, hole=1.5, deep=3,
                    pins=JLC_PINS, gap=1.0, fit=0.5, detail=1.0, tol=0.3,
                    small=[(5, 5, 5), (2, 2, 10)], big=(100, 100, 100), protrude=1.5),
        "PCBWay": None,
    },
    "FDM": {
        "JLC": dict(wall={50: 1.6, 100: 2.0, 200: 2.5}, hole=1.5, deep=3,
                    pins=JLC_PINS, gap=0.5, fit=0.5, detail=1.0, tol=0.3,
                    small=[(10, 30, 30)], big=(480, 480, 580), protrude=1.5),
        "PCBWay": dict(wall=1.5, tol=0.2, big=(500, 500, 600)),
    },
    "CNC metal": {
        "JLC": dict(wall=0.5, wall_rec=0.8, tol=0.1, corner="JLC"),
        "PCBWay": dict(wall=0.8, tol=0.1, corner="PCBWay", small=[(2, 2, 2)], big=(1000, 1000, 1000)),
    },
    "CNC plastic": {
        "JLC": dict(wall=1.0, wall_rec=1.5, tol=0.1, corner="JLC"),
        "PCBWay": dict(wall=1.5, tol=0.1, corner="PCBWay", small=[(2, 2, 2)], big=(1000, 1000, 1000)),
    },
